# Shirayuki Scrapper API v2 Base URL
VITE_SHIPAYUKI_API_URL=https://shirayuki-scrapper-api-v2.vercel.app
# Default provider (hianime, anixo, animex, anikuro, nyaa)
VITE_SHIPAYUKI_PROVIDER=hianime

# M3U8 Proxy for streaming playback (optional)
VITE_ANIMEPAHE_M3U8_PROXY=
VITE_M3U8_PROXY_URL=
VITE_PROXY_URL=

# Supabase for auth, watchlist, and continue-watching (optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
