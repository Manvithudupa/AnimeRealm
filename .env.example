# Kenjitsu API base URL
VITE_KENJITSU_API_URL=https://kenjitsu.koyeb.app
# Anime provider namespace used for playback and provider search
VITE_ANIME_PROVIDER=anibd
# M3U8 proxy for providers that require a Referer header (optional)
VITE_M3U8_PROXY_URL=
# Supabase for auth, watchlist, and continue-watching (optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
